# Set through Sites runtime settings, not source code.
# Shared admin login. Store the hash as a secret, never the password.
ADMIN_LOGIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional confirmed canonical HTTPS origin, e.g. https://your-owned-domain.example
# Leave unset for local preview. Do not insert an unconfirmed production domain.
PUBLIC_SITE_URL=
# Opt in only after reviewed Supabase migration + catalogue verification.
# CATALOG_BACKEND=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY= (server secret; never commit its value)
# Delivery credentials: server only. No credentials => lookups stay disabled.
NOVA_POSHTA_API_KEY=
# Sender city's Nova Poshta Ref; required only for delivery estimates.
NOVA_POSHTA_SENDER_CITY_REF=
UKRPOSHTA_BEARER=
# LiqPay sandbox only. Production payment activation is a separate approval/test.
LIQPAY_MODE=sandbox
LIQPAY_API_VERSION=7
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
